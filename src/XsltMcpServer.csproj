<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>xslt-mcp-server</AssemblyName>
    <RootNamespace>XsltMcpServer</RootNamespace>
    <Description>MCP server providing XSLT spec reference lookup and XSLT/XPath execution</Description>
    <Version>1.5.0</Version>
    <PackageReleaseNotes>Major release — every execution tool now returns structured JSON instead of plain strings, plus new tools for compile-once-apply-many, parameter binding, secondary documents, spec-aware streamability analysis, and MCP discoverability. AI agents can now parse failures and self-correct using source-location-aware errors. Highlights: xslt_compile + xslt_apply with SHA256 handle cache; stylesheet parameter binding via JSON; secondary-document registration for doc()/document() against in-memory XML; xslt_explain_streamability with per-mode and per-template streamability analysis (catches the streaming mistakes models make most often); xslt_find_examples with 8 curated working examples (xsl:merge, xsl:fork, xsl:accumulator, xsl:iterate, streaming-mode, xsl:package, fn:transform, xsl:evaluate); xslt_suggest_fix with top-10 error-code rules; xslt_compare_versions; xslt_test assertion runner; server_capabilities; 4 MCP prompts for guided workflows; browsable spec corpus via xslt:// resources. Runtime exception handling narrowed to engine-specific types — no more silently swallowed OOM/cancellation. Structured error codes XMCP0001 (unknown handle), XMCP0002 (bad parameters JSON), XMCP0003 (bad documents JSON). Fixed: invalid XPath in xpath_evaluate previously leaked XQueryParseException; relative URIs in doc() now work in xslt_apply. See RELEASES.md for the full per-phase changelog.</PackageReleaseNotes>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>xslt-mcp</ToolCommandName>
    <PackageId>xslt-mcp</PackageId>
    <PackageTags>xslt;mcp;model-context-protocol;xml;spec;ai</PackageTags>
    <RepositoryUrl>https://github.com/phoenixmldb/xslt-mcp</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CA1303;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="PhoenixmlDb.Xslt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../spec/concepts/**/*.md" />
    <EmbeddedResource Include="../spec/error-codes/**/*.md" />
    <EmbeddedResource Include="../spec/examples/**/*.md">
      <LogicalName>examples.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../spec/instructions/**/*.md" />
    <EmbeddedResource Include="../spec/output-methods/**/*.md" />
    <EmbeddedResource Include="../spec/xpath/**/*.md" />
  </ItemGroup>

</Project>
